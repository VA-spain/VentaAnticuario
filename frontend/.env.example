# Opcional: copia este fichero a .env.local solo si necesitas cambiar algo.
# Sin fichero, la web usa estos mismos valores por defecto.

# Dirección del backend en Python (solo la usa el servidor de Next.js, nunca el navegador).
BACKEND_URL=http://127.0.0.1:8000

# La cookie de sesión solo viaja por HTTPS en producción. Ponlo a false únicamente para
# probar la compilación de producción en local sin HTTPS (npm run build && npm run start).
# SESSION_COOKIE_SECURE=false
