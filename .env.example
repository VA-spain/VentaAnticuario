# Copia este fichero a .env y cambia los valores. El .env no se sube al repositorio.
# Lo leen dos piezas: docker compose (para crear la base de datos) y el backend en Python.

# --- MySQL (contenedor Docker) ---
MYSQL_ROOT_PASSWORD=cambia-esta-clave-de-root
MYSQL_DATABASE=venta_anticuario
MYSQL_USER=va_app
MYSQL_PASSWORD=cambia-esta-clave-de-la-app
# Dónde escucha MySQL en este equipo (solo en 127.0.0.1, no se expone a la red)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# --- Backend ---
# Minutos que dura la cookie de sesión en el navegador
SESSION_TTL_MINUTES=480

# --- Usuarios de prueba ---
# `python -m app.cli init-db` crea (o actualiza) estos dos usuarios con la contraseña ya cifrada:
# un cliente normal y un administrador. Sin contraseña, ese usuario no se crea.
DEMO_USER_USERNAME=cliente
DEMO_USER_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
